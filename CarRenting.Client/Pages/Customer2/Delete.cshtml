@page
@model CarRenting.Client.Pages.Customer2.DeleteModel
@{
    ViewData["Title"] = "Delete";
    string JWTToken = HttpContext.Session.GetString("JWToken");
    var api = Constants.Api + "Renting";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card-clean">
            <h4 class="mb-1">Delete Renting Transaction</h4>
            <p class="text-muted mb-0">Are you sure to delete this Renting Transaction?</p>
            <hr />

            <input type="text" class="form-control" id="RentingTransationId" hidden />

            <div class="mb-3">
                <label class="form-label" for="RentingDate">Renting Date</label>
                <input type="date" class="form-control" id="RentingDate" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label" for="TotalPrice">Total Price</label>
                <input type="text" class="form-control" id="TotalPrice" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label" for="CustomerId">Customer Id</label>
                <input type="text" class="form-control" id="CustomerId" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label" for="RentingStatus">Renting Status</label>
                <input type="number" class="form-control" id="RentingStatus" readonly />
            </div>

            <div class="d-flex gap-2 mt-4">
                <a href="./Index" class="btn btn-outline-secondary flex-fill">Back</a>
                <button id="DeleteButton" class="btn btn-danger flex-fill">Yes. Delete!</button>
            </div>
        </div>
    </div>
</div>

@section scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            const params = (new URL(document.location)).searchParams;
            const id = params.get("id");

            GetRentingTransaction();

            function GetRentingTransaction() {
                $.ajax({
                    url: "@api" + "/Renting/" + id,
                    type: "GET",
                    dataType: "json",
                    success: function (result) {
                        $("#RentingTransationId").val(result.rentingTransationId);
                        var rentingDate = new Date(result.rentingDate);
                        var rentingDateFormatted = rentingDate.toISOString().split('T')[0];
                        $("#RentingDate").val(rentingDateFormatted);
                        $("#TotalPrice").val(result.totalPrice);
                        $("#CustomerId").val(result.customerId);
                        $("#RentingStatus").val(result.rentingStatus);
                    },
                    error: function (error) {
                        console.log(error);
                    }
                })
            }

            $("#DeleteButton").click(function () {
                $.ajax({
                    url: "@api" + "/" + id,
                    type: "Delete",
                    contentType: "application/json",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("Authorization", "Bearer " + "@JWTToken");
                    },
                    success: function (result, status, xhr) {
                        alert("Delete successfully");
                        // Redirect to home
                        window.location.href = "./Index";
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr);
                        alert("Delete failed");
                    }
                })
            })
        })
    </script>
}
