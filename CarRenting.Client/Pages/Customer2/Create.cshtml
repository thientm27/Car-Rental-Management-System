@page
@model CarRenting.Client.Pages.Customer2.CreateModel
@{
    ViewData["Title"] = "Create";
    string JWTToken = HttpContext.Session.GetString("JWToken");
    var userID = HttpContext.Session.GetString("UserId");
    var api = Constants.Api + "Renting";
}

<h4>Create new renting</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="form-group mt-2">
            <input type="text" class="form-control" id="CustomerId" hidden />
        </div>
        <div class="form-group mt-2">
            <label for="RentingDate">Renting Date</label>
            <input type="date" class="form-control" id="RentingDate" readonly />
            <span id="RentingDate-error" class="text-danger"></span>
        </div>
        <div class="form-group mt-2">
            <label for="TotalPrice">Total Price</label>
            <input type="number" class="form-control" id="TotalPrice" readonly />
            <span id="TotalPrice-error" class="text-danger"></span>
        </div>
        <div class="form-group mt-4">
            <button id="CreateButton" class="btn btn-primary w-100">Create</button>
        </div>
    </div>
</div>

<br />
<hr />
<br />
<!-- CURRENT RENTING -->

<div class="table-responsive">
    <table class="table table-hover align-middle" id="table1">
        <thead>
            <tr>
                <th>StartDate</th>
                <th>EndDate</th>
                <th>Price</th>
                <th>CarName</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<br />
<hr />
<br />

<!-- FIND CAR -->
<h4>Find car available</h4>
<div class="row">
    <div class="col-md-4">
        <div class="form-group mt-2">
            <label for="StartDate">Start Date</label>
            <input type="date" id="StartDate" class="form-control" />
            <span id="StartDate-error" class="text-danger"></span>
        </div>
        <div class="form-group mt-2">
            <label for="EndDate">End Date</label>
            <input type="date" id="EndDate" class="form-control" />
            <span id="EndDate-error" class="text-danger"></span>
        </div>
        <div>
            <button id="FindCar" class="btn btn-primary w-100">Find Car</button>
        </div>
    </div>
</div>

<br />
<hr />
<br />

<div class="table-responsive">
    <table class="table table-hover align-middle" id="table2">
        <thead>
            <tr>
                <th>CarId</th>
                <th>CarName</th>
                <th>NumberOfDoors</th>
                <th>SeatingCapacity</th>
                <th>FuelType</th>
                <th>Year</th>
                <th>CarStatus</th>
                <th>CarRentingPricePerDay</th>
                <th>Manufacturer</th>
                <th>Supplier</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            // Dữ liệu xe từ lần tìm gần nhất, key là carId (string)
            var availableCars = {};

            // ===== Cart helpers =====
            function getCart() {
                var sessionData = JSON.parse(localStorage.getItem("Cart")) || { Items: [] };
                return sessionData.Items;
            }

            function saveCart(items) {
                var sessionData = JSON.parse(localStorage.getItem("Cart")) || { Items: [] };
                sessionData.Items = items;
                localStorage.setItem("Cart", JSON.stringify(sessionData));
            }

            function clearCart() {
                localStorage.removeItem("Cart");
            }

            // Hai khoảng ngày có giao nhau không (bao gồm cả ngày đầu và ngày cuối)
            function overlaps(aStart, aEnd, bStart, bEnd) {
                return bStart <= aEnd && aStart <= bEnd;
            }

            // ===== Init =====
            var today = new Date();
            var dd = String(today.getDate()).padStart(2, '0');
            var mm = String(today.getMonth() + 1).padStart(2, '0');
            var yyyy = today.getFullYear();
            $("#RentingDate").val(yyyy + '-' + mm + '-' + dd);

            populateTable1(getCart());

            // ===== Render =====
            function renderCarRow(car) {
                var tr = $("<tr>");
                tr.append($("<td>").text(car.carId));
                tr.append($("<td>").text(car.carName));
                tr.append($("<td>").text(car.numberOfDoors));
                tr.append($("<td>").text(car.seatingCapacity));
                tr.append($("<td>").text(car.fuelType));
                tr.append($("<td>").text(car.year));
                tr.append($("<td>").text(car.carStatus));
                tr.append($("<td>").text(car.carRentingPricePerDay));
                tr.append($("<td>").text(car.manufacturer ? car.manufacturer.manufacturerName : ""));
                tr.append($("<td>").text(car.supplier ? car.supplier.supplierName : ""));
                tr.append($("<td>").append($("<button class='btn btn-primary btn-sm addCarBtn'>Add Car</button>")));
                $("#table2 tbody").append(tr);
            }

            function isCarShown(carId) {
                return $("#table2 tbody td:first-child").filter(function () {
                    return $(this).text() === String(carId);
                }).length > 0;
            }

            function populateTable1(items) {
                var tbody = $("#table1 tbody").empty();
                var total = 0;

                items.forEach(function (item) {
                    var tr = $("<tr>");
                    tr.append($("<td>").text(item.StartDate));
                    tr.append($("<td>").text(item.EndDate));
                    tr.append($("<td>").text(item.Price));
                    tr.append($("<td>").text(item.CarName));
                    tr.append($("<td>").html('<button class="btn btn-danger btn-sm removeRow">Remove</button>'));
                    tbody.append(tr);

                    total += parseFloat(item.Price);
                });

                $("#TotalPrice").val(total);
            }

            // ===== Find car =====
            $("#FindCar").click(function () {
                var startDate = $("#StartDate").val();
                var endDate = $("#EndDate").val();

                if (!startDate || !endDate) {
                    alert("Start date and end date are required.");
                    return;
                }

                var todayStr = new Date().toISOString().split('T')[0];
                if (startDate < todayStr) {
                    alert("Start date cannot be in the past.");
                    return;
                }
                if (endDate < todayStr) {
                    alert("End date cannot be in the past.");
                    return;
                }
                if (new Date(endDate) <= new Date(startDate)) {
                    alert("End date must be greater than the start date.");
                    return;
                }

                var selStart = new Date(startDate);
                var selEnd = new Date(endDate);

                // Xe đã có trong giỏ với khoảng ngày giao nhau thì ẩn đi
                var ignoreIds = getCart()
                    .filter(function (item) {
                        return overlaps(new Date(item.StartDate), new Date(item.EndDate), selStart, selEnd);
                    })
                    .map(function (item) { return String(item.CarId); });

                $.ajax({
                    url: "@api" + "/AvailableCar",
                    type: "POST",
                    data: JSON.stringify({
                        "startDateTime": startDate,
                        "endDateTime": endDate,
                    }),
                    contentType: "application/json",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("Authorization", "Bearer " + "@JWTToken");
                    },
                    success: function (result) {
                        $("#table2 tbody").empty();
                        availableCars = {};

                        $.each(result, function (i, car) {
                            var id = String(car.carId);
                            availableCars[id] = car;
                            if (ignoreIds.indexOf(id) === -1) {
                                renderCarRow(car);
                            }
                        });
                    },
                    error: function (xhr) {
                        console.log(xhr);
                    }
                });
            });

            // ===== Add car to cart =====
            $("#table2").on("click", "button.addCarBtn", function () {
                var row = $(this).closest("tr");
                var carId = row.find("td:eq(0)").text();
                var car = availableCars[carId];
                if (!car) {
                    return;
                }

                var startDay = new Date($("#StartDate").val());
                var endDay = new Date($("#EndDate").val());
                var numberOfDays = Math.ceil((endDay - startDay) / (24 * 60 * 60 * 1000));
                var price = numberOfDays * parseFloat(car.carRentingPricePerDay);

                var items = getCart();
                items.push({
                    RentingTransactionId: 0,
                    CarId: carId,
                    StartDate: startDay,
                    EndDate: endDay,
                    Price: price,
                    CarName: car.carName,
                    CarInfo: car   // lưu để có thể đưa lại vào bảng khi Remove
                });
                saveCart(items);

                row.remove();
                populateTable1(items);
            });

            // ===== Remove car from cart =====
            $("#table1").on("click", ".removeRow", function () {
                var index = $(this).closest("tr").index();
                var items = getCart();
                var removed = items.splice(index, 1)[0];
                saveCart(items);
                populateTable1(items);

                // Đưa xe trở lại bảng available ngay, nếu đang tìm đúng khoảng ngày của item đó
                if (removed && removed.CarInfo && sameSelectedRange(removed) && !isCarShown(removed.CarId)) {
                    availableCars[String(removed.CarId)] = removed.CarInfo;
                    renderCarRow(removed.CarInfo);
                }
            });

            function sameSelectedRange(item) {
                var s = $("#StartDate").val();
                var e = $("#EndDate").val();
                if (!s || !e) {
                    return false;
                }
                return new Date(item.StartDate).getTime() === new Date(s).getTime()
                    && new Date(item.EndDate).getTime() === new Date(e).getTime();
            }

            // ===== Submit renting =====
            $("#CreateButton").click(function () {
                var items = getCart();
                if (items.length === 0) {
                    alert("Cannot submit. Renting details are empty.");
                    return;
                }

                // Chỉ gửi các field API cần, bỏ CarInfo
                var details = items.map(function (item) {
                    return {
                        RentingTransactionId: 0,
                        CarId: parseInt(item.CarId, 10),
                        StartDate: item.StartDate,
                        EndDate: item.EndDate,
                        Price: item.Price,
                        CarName: item.CarName
                    };
                });

                var requestData = {
                    RentingTransationId: 0,
                    RentingDate: $("#RentingDate").val(),
                    TotalPrice: parseFloat($("#TotalPrice").val()),
                    CustomerId: @userID,
                    RentingStatus: 1,
                    RentingDetails: details
                };

                $.ajax({
                    url: "@api",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(requestData),
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("Authorization", "Bearer " + "@JWTToken");
                    },
                    success: function () {
                        alert("Renting transaction created successfully.");
                        clearCart();
                        window.location.href = "./Index";
                    },
                    error: function () {
                        alert("Renting transaction created fail. Maybe your car has been rented");
                        clearCart();
                        populateTable1(getCart());
                    }
                });
            });
        });
    </script>
}